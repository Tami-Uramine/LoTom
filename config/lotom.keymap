#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-input-processor.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <1>;
    temp-layer-activation-delay-ms = <0>;
    temp-layer-deactivation-delay-ms = <400>;
};

/ {
    behaviors {
      scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
          compatible = "zmk,behavior-runtime-sensor-rotate";
          label = "ENCODER_MSC_DOWN_UP";
          #sensor-binding-cells = <0>;
          cw-binding = <&msc SCRL_DOWN>;
          ccw-binding = <&msc SCRL_UP>;
          tap-ms = <20>;
      };

      bottom_rotate: behavior_sensor_rotate_bottom {
          compatible = "zmk,behavior-runtime-sensor-rotate";
          label = "ENCODER_BOTTOM";
          #sensor-binding-cells = <0>;
          cw-binding = <&kp LA(LG(RIGHT_ARROW))>;
          ccw-binding = <&kp LA(LG(LEFT_ARROW))>;
          tap-ms = <20>;
      };


        lt_mouse: layer_tap_mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_MOUSE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        mt_mouse: mod_tap_mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_MOUSE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&mkp>;
        };


        lt_slow: layer_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SLOW";
            #binding-cells = <2>;
            tapping-term-ms = <600>; // ここで判定時間をミリ秒単位で指定
            flavor = "tap-preferred"; // タップを優先する設定（誤爆防止に推奨）
            bindings = <&mo>, <&kp>;
        };

        lt_middle: layer_tap_middle {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_MIDDLE";
            #binding-cells = <2>;
            tapping-term-ms = <400>; // ここで判定時間をミリ秒単位で指定
            flavor = "tap-preferred"; // タップを優先する設定（誤爆防止に推奨）
            bindings = <&mo>, <&kp>;
        };

        mt_slow: mod_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_SLOW";
            #binding-cells = <2>;
            tapping-term-ms = <600>;     // 判定時間（長めに設定）
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&kp>;

            // Hold側もTap側もキー入力（kp）を使用
        };

        mt_middle: mod_tap_middle {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_MIDDLE";
            #binding-cells = <2>;
            tapping-term-ms = <400>;     // 判定時間（長めに設定）
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&kp>;

            // Hold側もTap側もキー入力（kp）を使用
        };

        mt_to0_henkan: mt_to0_henkan {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TO0_HENKAN";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&to0_henkan>;
        };

        mt_to0_i: mt_to0_i {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TO0_I";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&to0_i>;
        };

        mt_to0_o: mt_to0_o {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TO0_O";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&to0_o>;
        };
    };

    macros {
        to0_henkan: to0_henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp INT_HENKAN>;
        };

        to0_i: to0_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp I>;
        };

        to0_o: to0_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp O>;
        };
    };

    keymap: keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE                   &kp DELETE
&kp TAB                      &kp Q          &kp W             &kp E               &kp R             &kp T              &kp Y        &kp U        &mt_middle RCTRL I  &mt_middle RIGHT_ALT O  &kp P               &kp BSPC
&mt LSHIFT INT_HENKAN        &kp A          &kp S             &kp D               &kp F             &kp G              &kp H        &kp J        &lt_middle 2 K      &lt_middle 3 L          &lt_middle 4 MINUS  &mt RIGHT_SHIFT INT_HENKAN
&mt LEFT_SHIFT INT_MUHENKAN  &kp Z          &kp X             &kp C               &kp V             &kp B              &kp N        &kp M        &kp COMMA           &kp DOT                 &kp FSLH            &mt RIGHT_SHIFT INT_MUHENKAN
&kp BSLH                     &kp SEMICOLON  &kp SINGLE_QUOTE  &lt_middle 7 GRAVE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &lt 5 SPACE  &lt 6 ENTER  &kp TAB             &kp LEFT_GUI
            >;

            sensor-bindings = <
                <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>,
                &scroll_up_down
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &mt_to0_i RCTRL 0  &mt_to0_o RIGHT_ALT 0  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &lt_mouse 2 MCLK   &lt_mouse 3 RCLK       &trans  &mt_to0_henkan RIGHT_SHIFT 0
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans             &trans                 &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans             &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans         &trans  &trans      &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans       &trans  &trans  &kp LC(N0)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans         &trans  &trans      &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_UP  &kp PAGE_DOWN  &trans  &trans
            >;
        };

        COMMAND {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(H)            &kp LC(F)           &kp LC(A)  &trans            &kp LC(B)  &kp LC(L)
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(X)            &kp LC(C)           &kp LC(V)  &trans            &kp LC(U)  &kp LC(E)
&trans  &trans  &trans  &trans  &trans  &trans  &kp LA(RIGHT_ARROW)  &kp LA(LEFT_ARROW)  &kp LG(V)  &trans            &kp LC(I)  &kp LC(R)
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(Y)            &kp LC(Z)           &kp LC(M)  &kp LC(NUMBER_1)
            >;
        };

        ARROW {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(T)          &kp HOME            &kp UP_ARROW    &mt RIGHT_ALT END    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(W)          &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(TAB)        &kp LG(LEFT_ARROW)  &kp LG(D)       &kp LG(RIGHT_ARROW)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mt LCTRL LG(TAB)  &mt LSHIFT LA(F4)   &trans          &trans
            >;
        };

        NUM {
            bindings = <
&trans  &kp EQUAL
&trans  &trans     &trans  &trans  &trans  &trans  &kp ESCAPE  &kp N7     &kp N8                &kp N9                 &kp LS(SEMI)  &kp LS(SINGLE_QUOTE)
&trans  &trans     &trans  &trans  &trans  &trans  &kp TAB     &kp N4     &kp N5                &kp N6                 &kp MINUS     &mt_middle RIGHT_SHIFT LS(EQUAL)
&trans  &trans     &trans  &trans  &trans  &trans  &kp N0      &kp N1     &kp N2                &kp N3                 &kp FSLH      &mt_middle RIGHT_SHIFT LS(N8)
&trans  &trans     &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
            >;
        };

        FUNCTION {
            bindings = <
&trans  &kp LA(LC(DELETE))
&trans  &trans              &trans  &trans  &trans  &trans  &kp F1   &kp F2   &kp F3                &kp F4                 &kp F5         &kp LC(EQUAL)
&trans  &trans              &trans  &trans  &trans  &trans  &kp F6   &kp F7   &kp F8                &kp F9                 &kp F10        &kp LC(LS(EQUAL))
&trans  &trans              &trans  &trans  &trans  &trans  &kp F11  &kp F12  &kp LC(S)             &kp LC(P)              &kp LG(LS(S))  &kp LC(MINUS)
&trans  &trans              &trans  &trans  &trans  &trans  &trans   &trans   &kp LC(LEFT_BRACKET)  &kp LC(RIGHT_BRACKET)
            >;
        };

        Bluetooth {
            bindings = <
&studio_unlock  &trans
&trans          &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2          &bt BT_SEL 3          &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans             &trans           &trans                &trans                &trans        &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR      &trans             &trans           &trans                &trans                &trans        &trans  &trans  &trans  &trans
            >;
        };
    };
};
