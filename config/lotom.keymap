#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

/ {
    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        tab_slide: behavior_sensor_rotate_tab_slide {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_TAB_SLIDE";
            #sensor-binding-cells = <0>;
            bindings = <&kp LA(LG(RIGHT_ARROW))>, <&kp LA(LG(LEFT_ARROW))>;

            tap-ms = <20>;
        };

        sl_mouse: sticky_layer_for_mouse {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <200>;
            quick-release;
            ignore-modifiers;
        };

        lt_mouse: layer_tap_mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_MOUSE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        mt_mouse: mod_tap_mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_MOUSE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&mkp>;
        };

        lt_zoom: lt_zoom {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            bindings = <&zoom_ctrl_on>, <&kp>;
        };

        lt_zoom_mouse: lt_zoom_mouse {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&zoom_ctrl_on>, <&mkp>;
        };

        lt_slow: layer_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SLOW";
            #binding-cells = <2>;
            tapping-term-ms = <600>; // ここで判定時間をミリ秒単位で指定
            flavor = "tap-preferred"; // タップを優先する設定（誤爆防止に推奨）
            bindings = <&mo>, <&kp>;
        };

        lt_middle: layer_tap_middle {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_MIDDLE";
            #binding-cells = <2>;
            tapping-term-ms = <400>; // ここで判定時間をミリ秒単位で指定
            flavor = "tap-preferred"; // タップを優先する設定（誤爆防止に推奨）
            bindings = <&mo>, <&kp>;
        };

        mt_slow: mod_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_SLOW";
            #binding-cells = <2>;
            tapping-term-ms = <600>;     // 判定時間（長めに設定）
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&kp>;

            // Hold側もTap側もキー入力（kp）を使用
        };

        mt_middle: mod_tap_middle {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_MIDDLE";
            #binding-cells = <2>;
            tapping-term-ms = <400>;     // 判定時間（長めに設定）
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&kp>;

            // Hold側もTap側もキー入力（kp）を使用
        };

        mt_to0_henkan: mt_to0_henkan {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TO0_HENKAN";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&to0_henkan>;
        };

        mt_to0_muhenkan: mt_to0_muhenkan {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TO0_MUHENKAN";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&to0_muhenkan>;
        };

        mt_to0_i: mt_to0_i {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TO0_I";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&to0_i>;
        };

        mt_to0_o: mt_to0_o {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TO0_O";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&to0_o>;
        };

        lt_to0_minus: lt_to0_minus {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO0_MINUS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to0_minus>;
        };

        lt_to0_space: lt_to0_space {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO0_SPACE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to0_space>;
        };

        lt_to0_enter: lt_to0_enter {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO0_ENTER";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to0_enter>;
        };

        lt_to0_grave: lt_to0_grave {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO0_GRAVE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to0_grave>;
        };

        lt_to0_lbracket: lt_to0_lbracket {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO0_LBRACKET";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to0_lbracket>;
        };

        lt_to0_rbracket: lt_to0_rbracket {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TO0_RBRACKET";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to0_rbracket>;
        };
    };

    macros {
        lclick_and_exit: lclick_and_exit {
            label = "LCLICK_AND_EXIT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mkp MB1>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB1>,
                <&macro_tap>,
                <&to 0>,
                <&macro_tap>,
                <&sl_mouse 0>;
        };

        rclick_and_exit: rclick_and_exit {
            label = "RCLICK_AND_EXIT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mkp MB2>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB2>,
                <&macro_tap>,
                <&to 0>,
                <&macro_tap>;
        };

        zoom_ctrl_on: zoom_ctrl_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 0>,
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 0>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        zoom_up: zoom_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_press>,
                <&msc SCRL_UP>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&msc SCRL_UP>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        zoom_down: zoom_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_press>,
                <&msc SCRL_DOWN>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&msc SCRL_DOWN>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        to0_henkan: to0_henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp INT_HENKAN>;
        };

        to0_muhenkan: to0_muhenkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp INT_MUHENKAN>;
        };

        to0_i: to0_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp I>;
        };

        to0_o: to0_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp O>;
        };

        to0_esc: to0_esc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp ESCAPE>;
        };

        to0_del: to0_del {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp DELETE>;
        };

        to0_tab: to0_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp TAB>;
        };

        to0_q: to0_q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp Q>;
        };

        to0_w: to0_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp W>;
        };

        to0_e: to0_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp E>;
        };

        to0_r: to0_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp R>;
        };

        to0_t: to0_t {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp T>;
        };

        to0_y: to0_y {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp Y>;
        };

        to0_u: to0_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp U>;
        };

        to0_p: to0_p {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp P>;
        };

        to0_bspc: to0_bspc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp BSPC>;
        };

        to0_a: to0_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp A>;
        };

        to0_s: to0_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp S>;
        };

        to0_d: to0_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp D>;
        };

        to0_f: to0_f {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp F>;
        };

        to0_g: to0_g {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp G>;
        };

        to0_h: to0_h {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp H>;
        };

        to0_minus: to0_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp MINUS>;
        };

        to0_z: to0_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp Z>;
        };

        to0_x: to0_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp X>;
        };

        to0_c: to0_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp C>;
        };

        to0_v: to0_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp V>;
        };

        to0_b: to0_b {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp B>;
        };

        to0_n: to0_n {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp N>;
        };

        to0_m: to0_m {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp M>;
        };

        to0_comma: to0_comma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp COMMA>;
        };

        to0_dot: to0_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp DOT>;
        };

        to0_slash: to0_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp FSLH>;
        };

        to0_bslash: to0_bslash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp BSLH>;
        };

        to0_semicolon: to0_semicolon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp SEMICOLON>;
        };

        to0_quote: to0_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp SINGLE_QUOTE>;
        };

        to0_grave: to0_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp GRAVE>;
        };

        to0_lbracket: to0_lbracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LEFT_BRACKET>;
        };

        to0_rbracket: to0_rbracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp RIGHT_BRACKET>;
        };

        to0_space: to0_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp SPACE>;
        };

        to0_enter: to0_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp ENTER>;
        };

        to0_gui: to0_gui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LEFT_GUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE                   &kp DELETE
&kp TAB                      &kp Q          &mt_middle LEFT_ALT W  &mt_middle LCTRL E  &kp R               &kp T                &kp Y        &kp U        &mt_middle RCTRL I  &mt_middle RIGHT_ALT O  &kp P               &kp BSPC
&mt LSHIFT INT_HENKAN        &kp A          &kp S                  &kp D               &kp F               &kp G                &kp H        &kp J        &lt_middle 2 K      &lt_middle 3 L          &lt_middle 4 MINUS  &mt RIGHT_SHIFT INT_HENKAN
&mt LEFT_SHIFT INT_MUHENKAN  &kp Z          &kp X                  &kp C               &kp V               &kp B                &kp N        &kp M        &kp COMMA           &kp DOT                 &kp FSLH            &mt RIGHT_SHIFT INT_MUHENKAN
&kp BSLH                     &kp SEMICOLON  &kp SINGLE_QUOTE       &lt_middle 9 GRAVE  &lt 8 LEFT_BRACKET  &lt 7 RIGHT_BRACKET  &lt 5 SPACE  &lt 6 ENTER  &kp TAB             &kp LEFT_GUI
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        MOUSE {
            bindings = <
&to0_esc                       &to0_del
&to0_tab                       &to0_q          &to0_w      &to0_e             &to0_r                &to0_t                &to0_y             &to0_u             &mt_to0_i RCTRL 0  &mt_to0_o RIGHT_ALT 0  &to0_p             &to0_bspc
&mt_to0_henkan LEFT_SHIFT 0    &to0_a          &to0_s      &to0_d             &to0_f                &to0_g                &to0_h             &mkp LCLK          &lt_mouse 2 MCLK   &lt_mouse 3 RCLK       &lt_to0_minus 4 0  &mt_to0_henkan RIGHT_SHIFT 0
&mt_to0_muhenkan LEFT_SHIFT 0  &to0_z          &to0_x      &to0_c             &to0_v                &to0_b                &to0_n             &to0_m             &to0_comma         &to0_dot               &to0_slash         &mt_to0_muhenkan RIGHT_SHIFT 0
&to0_bslash                    &to0_semicolon  &to0_quote  &lt_to0_grave 9 0  &lt_to0_lbracket 8 0  &lt_to0_rbracket 7 0  &lt_to0_space 5 0  &lt_to0_enter 6 0  &to0_tab           &to0_gui
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans         &trans  &trans      &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &zoom_up       &trans  &zoom_down  &kp LC(N0)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans         &trans  &trans      &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_UP  &kp PAGE_DOWN  &trans  &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        COMMAND {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(H)           &kp LC(F)           &kp LC(A)  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(X)           &kp LC(C)           &kp LC(V)  &trans  &kp RA(G)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LA(DOWN_ARROW)  &kp LA(LEFT_ARROW)  &kp LG(V)  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(Y)           &kp LC(Z)           &trans     &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(T)          &kp HOME            &kp UP_ARROW    &mt RIGHT_ALT END    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(W)          &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(TAB)        &kp LG(LEFT_ARROW)  &kp LG(D)       &kp LG(RIGHT_ARROW)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mt LCTRL LG(TAB)  &mt LSHIFT LA(F4)   &trans          &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        NUM {
            bindings = <
&trans  &kp EQUAL
&trans  &trans     &trans  &trans  &trans  &trans  &kp ESCAPE  &kp N7     &kp N8                &kp N9                 &kp LS(SEMI)  &kp LS(SINGLE_QUOTE)
&trans  &trans     &trans  &trans  &trans  &trans  &kp TAB     &kp N4     &kp N5                &kp N6                 &kp MINUS     &mt_middle RIGHT_SHIFT LS(EQUAL)
&trans  &trans     &trans  &trans  &trans  &trans  &kp N0      &kp N1     &kp N2                &kp N3                 &kp FSLH      &mt_middle RIGHT_SHIFT LS(N8)
&trans  &trans     &trans  &trans  &trans  &trans  &trans      &kp ENTER  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        FUNCTION {
            bindings = <
&trans  &kp LA(LC(DELETE))
&trans  &trans              &trans  &trans  &trans  &trans  &kp F1   &kp F2   &kp F3                &kp F4                 &kp F5         &kp LC(EQUAL)
&trans  &trans              &trans  &trans  &trans  &trans  &kp F6   &kp F7   &kp F8                &kp F9                 &kp F10        &kp LC(LS(EQUAL))
&trans  &trans              &trans  &trans  &trans  &trans  &kp F11  &kp F12  &kp LC(S)             &kp LC(P)              &kp LG(LS(S))  &kp LC(MINUS)
&trans  &trans              &trans  &trans  &trans  &trans  &trans   &trans   &kp LC(LEFT_BRACKET)  &kp LC(RIGHT_BRACKET)
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        Symbol {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LS(NUMBER_7)     &trans            &trans            &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LS(NUMBER_4)     &kp LS(NUMBER_5)  &kp LS(NUMBER_6)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LS(EXCLAMATION)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans               &trans            &trans
            >;
        };

        Office {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(L)  &kp LC(E)         &kp LC(R)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(B)  &kp LC(U)         &kp LC(I)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(M)  &kp LC(NUMBER_1)  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans            &trans
            >;
        };

        Bluetooth {
            bindings = <
&studio_unlock  &trans
&trans          &bt BT_SEL 0       &bt BT_SEL 1     &bt BT_SEL 2          &bt BT_SEL 3          &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans             &trans           &trans                &trans                &trans        &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR      &trans             &trans           &trans                &trans                &trans        &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };
    };
};
