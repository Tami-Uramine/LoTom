#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

/ {
    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        tab_slide: behavior_sensor_rotate_tab_slide {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_TAB_SLIDE";
            #sensor-binding-cells = <0>;
            bindings = <&kp LA(LG(RIGHT_ARROW))>, <&kp LA(LG(LEFT_ARROW))>;

            tap-ms = <20>;
        };

        mt_mouse: mt_mouse {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&mkp>;
        };

        lt_zoom: lt_zoom {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&lt_zoom_on>, <&kp>;
        };

        lt_ctrl: lt_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&lt_ctrl_on>, <&kp>;
        };

        lt_alt: lt_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&lt_alt_on>, <&kp>;
        };

        lt_slow: layer_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SLOW";
            #binding-cells = <2>;
            tapping-term-ms = <600>; // ここで判定時間をミリ秒単位で指定
            flavor = "tap-preferred"; // タップを優先する設定（誤爆防止に推奨）
            bindings = <&mo>, <&kp>;
        };

        lt_middle: layer_tap_middle {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_MIDDLE";
            #binding-cells = <2>;
            tapping-term-ms = <400>; // ここで判定時間をミリ秒単位で指定
            flavor = "tap-preferred"; // タップを優先する設定（誤爆防止に推奨）
            bindings = <&mo>, <&kp>;
        };

        mt_slow: mod_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_SLOW";
            #binding-cells = <2>;
            tapping-term-ms = <600>;     // 判定時間（長めに設定）
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&kp>;

            // Hold側もTap側もキー入力（kp）を使用
        };

        mt_middle: mod_tap_middle {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_MIDDLE";
            #binding-cells = <2>;
            tapping-term-ms = <400>;     // 判定時間（長めに設定）
            flavor = "tap-preferred";    // 迷った時はタップを優先（誤爆防止）
            bindings = <&kp>, <&kp>;

            // Hold側もTap側もキー入力（kp）を使用
        };
    };

    macros {
        lt_zoom_on: lt_zoom_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 2>,
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 2>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        lt_ctrl_on: lt_ctrl_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 6>,
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 6>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        lt_alt_on: lt_alt_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 8>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 8>,
                <&macro_release>,
                <&kp LALT>;
        };

        parens: parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS>;
        };

        bracket: bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LEFT_BRACKET &kp RIGHT_BRACKET>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp LS(NUMBER_2)         &kp DELETE
&kp LS(GRAVE)            &kp Q       &kp W    &kp E      &kp R        &kp T         &kp Y        &kp U        &kp I             &kp O                 &kp P                      &kp BSPC
&mt LSHIFT LS(NUMBER_1)  &kp A       &kp S    &kp D      &kp F        &kp G         &kp H        &kp J        &lt 1 K           &lt_zoom 0 L          &lt 3 MINUS                &mt RIGHT_SHIFT INT_HENKAN
&mt LCTRL LS(SLASH)      &kp Z       &kp X    &kp C      &kp V        &kp B         &kp N        &kp M        &mkp LCLK         &mt_mouse LCTRL MCLK  &mt_mouse LEFT_SHIFT RCLK  &lt 6 INT_MUHENKAN
&kp LS(NUMBER_7)         &bracket    &parens  &kp SLASH  &lt 5 COMMA  &lt 4 PERIOD  &lt 4 SPACE  &lt 5 ENTER  &lt_alt 0 ESCAPE  &lt 7 LEFT_GUI
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &kp LC(UP_ARROW)    &trans  &trans               &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &kp LC(LEFT_ARROW)  &trans  &kp LC(RIGHT_ARROW)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &kp LC(DOWN_ARROW)  &trans  &trans               &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_UP  &kp PAGE_DOWN       &trans  &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        ZOOM {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp A   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp X   &kp C   &kp V   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp H   &kp F   &kp N0  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp Z   &kp Y   &trans  &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(T)  &kp HOME         &kp UP_ARROW        &kp END            &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LC(W)  &kp LEFT_ARROW   &kp DOWN_ARROW      &kp RIGHT_ARROW    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &kp LC(PAGE_UP)  &kp LA(DOWN_ARROW)  &kp LC(PAGE_DOWN)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LCTRL  &kp LSHIFT       &trans              &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        NUM {
            bindings = <
&trans     &kp LS(SEMICOLON)
&trans     &trans             &trans         &trans            &trans            &trans        &kp RS(TAB)  &kp N7     &kp N8     &kp N9      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp GRAVE  &kp LS(BACKSLASH)  &kp BACKSLASH  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp NUMBER_6  &kp TAB      &kp N4     &kp N5     &kp N6      &kp MINUS             &kp LS(EQUAL)
&trans     &trans             &trans         &trans            &trans            &trans        &kp N0       &kp N1     &kp N2     &kp N3      &kp FSLH              &kp LS(N8)
&trans     &trans             &trans         &trans            &trans            &trans        &trans       &kp ENTER  &kp COMMA  &kp PERIOD
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        FUNCTION {
            bindings = <
&trans  &bt BT_SEL 0
&trans  &trans        &trans  &trans  &trans  &trans  &kp F1   &kp F2   &kp F3      &kp F4        &kp F5      &bt BT_SEL 1
&trans  &trans        &trans  &trans  &trans  &trans  &kp F6   &kp F7   &kp F8      &kp F9        &kp F10     &bt BT_SEL 2
&trans  &trans        &trans  &trans  &trans  &trans  &kp F11  &kp F12  &kp LC(S)   &kp LC(P)     &kp LA(F4)  &bt BT_SEL 3
&trans  &trans        &trans  &trans  &trans  &trans  &trans   &trans   &bt BT_CLR  &bt BT_SEL 4
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };

        CONTROL {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp B         &kp U      &kp I          &kp EQUAL         &kp LS(EQUAL)      &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans  &kp NUMBER_1  &kp J      &kp E          &kp L             &kp R              &kp LS(ENTER)
&trans  &trans  &trans  &trans  &trans  &trans  &kp N         &kp M      &mkp LCLK      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp SPACE     &kp ENTER  &kp SEMICOLON  &trans
            >;
        };

        WINDOWS {
            bindings = <
&trans  &kp LG(L)
&trans  &trans     &trans  &trans  &trans  &trans  &trans         &trans     &trans              &kp LG(UP_ARROW)    &trans               &trans
&trans  &trans     &trans  &trans  &trans  &trans  &trans         &trans     &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &trans
&trans  &trans     &trans  &trans  &trans  &trans  &kp LG(R)      &kp LG(Q)  &kp LG(X)           &kp LG(D)           &kp LG(TAB)          &trans
&trans  &trans     &trans  &trans  &trans  &trans  &kp LG(LS(S))  &kp LG(V)  &trans              &trans
            >;
        };

        ALT {
            bindings = <
&trans  &kp RC(DELETE)
&trans  &trans          &trans  &trans  &trans  &trans  &trans     &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans  &trans     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans  &trans     &kp LS(TAB)     &mkp LCLK       &kp TAB          &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans  &kp SPACE  &kp ENTER       &trans          &trans
            >;

            sensor-bindings = <
                &inc_dec_kp RIGHT_ARROW LEFT_ARROW
                &scroll_up_down
            >;
        };
    };
};
